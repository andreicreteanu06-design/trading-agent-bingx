# ---------- BingX ----------
# Creeaza cheia in BingX > API Management.
# IMPORTANT: NU activa "Withdraw". Pentru faza de semnale e suficient "Read".
BINGX_API_KEY=
BINGX_SECRET_KEY=

# ---------- Claude (optional, dar recomandat) ----------
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------- Telegram (optional) ----------
# BotFather -> /newbot ; chat id: scrie botului si deschide
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Webhook TradingView (optional) ----------
# Secret lung si aleatoriu. Fara el, receptorul refuza sa porneasca.
# Genereaza: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# ---------- Comportament ----------
# paper = doar semnale, zero ordine trimise catre exchange (recomandat la inceput)
# live  = permite trimiterea ordinelor DOAR dupa confirmare manuala in terminal
TRADING_MODE=paper
